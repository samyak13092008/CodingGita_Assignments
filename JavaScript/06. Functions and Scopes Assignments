// Section 1:What is a Function?

//1
//We use functions to avoid repeating the same code. A function allows us to write code once and use it multiple times whenever needed.
function greet(){
    console.log("Hello Students!");
}

greet();
greet();
greet();

//2
//a] Code Reusability: We can use the same function multiple times.
//b]Less Code Repetition: Functions prevent writing the same code again and again.
//c]Easy Debugging: Errors can be found and fixed easily.
//d]Better Organization: Functions divide a large program into smaller parts.

//3
//We can create one function containing the welcome message and call it six times wherever required.

function welcome() {
    console.log("Welcome to JavaScript!");
}

welcome();
welcome();
welcome();
welcome();
welcome();
welcome();

//4
//Without a function:
console.log("Welcome to CodingGita");
console.log("Welcome to CodingGita");

//With a function:
function greet(){
    console.log("Welcome to CodingGita");
}

greet();
greet();

//5
//A washing machine is a real-life example of a function. We put dirty clothes and detergent into the machine, start it, and it performs the washing process to give us clean clothes.
//Similarly, a function takes input, performs a task, and may produce an output.

//6
//Functions divide a large program into smaller parts. If an error occurs, we can check the particular function instead of checking the entire program.

// Section 2 : Function Declaration

//1
function displayCourse(){
    return "JavaScript Fundamentals";
}

console.log(displayCourse());

//2
function getStudentsStatus(){
    return "Active Learner";
}

let result = getStudentsStatus()
console.log(result);

//3
greet();

function greet(){
    console.log("Hello Students!");
}
//It works because function declarations are hoisted in JavaScript. This means they can be called before their actual definition in the code.

// Section 3: Function Expression

//1
const showMotto = function(){
    return "Code. Learn. Grow.";
}

console.log(showMotto())

//2
const getSemester = function(){
    return 3;
}

console.log(getSemester());

//3
console.log(greet());

const greet = function(){
    return "Hello";
}
//A function expression stored in a const or let variable cannot be accessed before initialization. Unlike function declarations, it is not available for calling before its definition.

// Section 4:Function Calling (Invocation)

//1
function greetStudent(){
    return "All the best for your coding journey!";
}

console.log(greetStudent());
console.log(greetStudent());
console.log(greetStudent());
console.log(greetStudent());

//2
const todayFocus = function(){
    return "Focus on functions today";
}

let result = todayFocus();
console.log(result);

//3
function first(){
    return "This is a function declaration";
}

const second = function(){
    return "This is a function expression";
};

console.log(first());
console.log(first());

console.log(second());
console.log(second());

// Section 5:Parametrs vs arguments

//1
function subtract(a,b){
    return a-b;
}

console.log(subtract(50,18));

//2
const greetUser = function(name){
    return "Welcome, "+ name + "!";
}

console.log(greetUser("Aarav"));

//3
function calculateArea(length, breadth){
    return length*breadth;
}

console.log(calculateArea(12,5));
console.log(calculateArea(8,9));

//4
//Parameter: A variable written inside the function definition that receives a value.
//Argument: The actual value passed to a function when calling it.

function add(a, b) {    //a,b are parametrs
    return a + b;
}

console.log(add(10, 20)); //10,20 are arguments

//5
//Yes, a function can have parameters but be called without arguments. In that case, the parameters get the value undefined by default.

// Section 6:Return Statement

//1
function squareOfNumber(n){
    return n**2;
}

console.log(squareOfNumber(9));

//2
function isAdult(age){
    if (age>=18){
        return true;
    }else{
        return false;
    }
}

console.log(isAdult(17));
console.log(isAdult(20));

//3
function getFullName(firstName, lastName){
    return firstName + "  " + lastName;
}

console.log(getFullName("Rohit", "Sharma"))

//4
//If a function does not have a return statement, JavaScript automatically returns undefined.

//5
//We use return to send a value back from a function so that we can store it in a variable, reuse it, or perform further calculations. console.log() only displays the value on the console and does not return that value from the function.

// Section 7: Why Use Functions? (Real-world Example)

//1
function getTotal(m1,m2,m3){
    return m1+m2+m3;
}

console.log(getTotal(95,90,99));
console.log(getTotal(85,80,89));
console.log(getTotal(90,97,96));
console.log(getTotal(77,87,93));

//2
function calculateSimpleInterest(principal, rate, time){
    return (principal*rate*time)/100;
}

console.log(calculateSimpleInterest(1000, 5, 7));
console.log(calculateSimpleInterest(7000, 7, 7));

//3

//Without a function:
let a = 80;
let b = 70;
let c = 90;

let average1 = (a+b+c)/3;

console.log(average1);

let x = 60;
let y = 75;
let z = 85;

let average2 = (x+y+z)/3;

console.log(average2);

//With a function:

function findAverage(a, b, c){
    return (a+b+c)/3;
}

console.log(findAverage(80, 70, 90));
console.log(findAverage(60, 75, 85));

//4
//Functions help reduce code repetition by allowing us to write a particular task once and execute it multiple times whenever required.
//Real-world example: In a shopping website, the total price calculation is required for different customers. Instead of writing the calculation again and again, we can create one function and use it for every customer.

//5
//a] Reusability: We can use a function multiple times without rewriting the code.
//b] Easy Debugging: Functions help identify and fix errors easily.
//c] Code Organization: Functions divide a large program into smaller and manageable parts.
